#!/bin/sh
# Run the current checkout's changeset checker. Never replace existing hook managers.
set -eu
root=$(git rev-parse --show-toplevel)
for candidate in python3 python3.14 python3.13 python3.12 python3.11; do
  if command -v "$candidate" >/dev/null 2>&1 &&
    "$candidate" -c 'import sys; sys.exit(sys.version_info < (3, 11))' 2>/dev/null; then
    exec "$candidate" "$root/scripts/changeset.py" check-staged
  fi
done
echo "changeset hook: Python 3.11+ must be available on PATH" >&2
exit 1
