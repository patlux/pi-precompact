[37.446882, "o", "\u001b[?2026h\u001b[1;1H\u001b[2K\u001b[48;2;46;66;27m \u001b[39m\u001b[1mread\u001b[22m\u001b[39m \u001b[38;2;170;148;234msrc/footer.ts\u001b[39m                                                                                                     \u001b[49m\u001b[0m\u001b]8;;\u0007\u001b[2;1H\u001b[2K\u001b[48;2;46;66;27m                                                                                                                        \u001b[49m\u001b[0m\u001b]8;;\u0007\u001b[4;1H\u001b[2K A zero-row widget finds the one mounted FooterComponent and wraps the render method of that instance. Pi's own context \u001b[0m\u001b]8;;\u0007\u001b[5;1H\u001b[2K text stays exactly as Pi renders it; the bar is drawn before it.                                                       \u001b[0m\u001b]8;;\u0007\u001b[6;1H\u001b[2K\u001b[0m\u001b]8;;\u0007\u001b[7;1H\u001b[2K\u001b[48;2;24;65;75m                                                                                                                        \u001b[49m\u001b[0m\u001b]8;;\u0007\u001b[8;1H\u001b[2K\u001b[48;2;24;65;75m \u001b[39mWhen does a background summary start?                                                                                  \u001b[49m\u001b[0m\u001b]8;;\u0007\u001b[9;1H\u001b[2K\u001b[48;2;24;65;7"]
[37.44697, "o", "5m                                                                                                                        \u001b[49m\u001b[0m\u001b]8;;\u0007\u001b[10;1H\u001b[2K\u001b[0m\u001b]8;;\u0007\u001b[11;1H\u001b[2K\u001b[48;2;46;66;27m                                                                                                                        \u001b[49m\u001b[0m\u001b]8;;\u0007\u001b[12;1H\u001b[2K\u001b[48;2;46;66;27m \u001b[39m\u001b[1mread\u001b[22m\u001b[39m \u001b[38;2;170;148;234msrc/controller.ts\u001b[39m                                                                                                 \u001b[49m\u001b[0m\u001b]8;;\u0007\u001b[13;1H\u001b[2K\u001b[48;2;46;66;27m                                                                                                                        \u001b[49m\u001b[0m\u001b]8;;\u0007\u001b[15;1H\u001b[2K After a completed turn, once the context reaches 85% of contextWindow minus Pi's reserve. With a 272k window Pi        \u001b[0m\u001b]8;;\u0007\u001b[16;1H\u001b[2K reserves 54,400 tokens, so the summary starts at 68%.                                                                  \u001b[0m\u001b]8;;\u0007\u001b[17;1H\u001b[2K\u001b[0m\u001b]8;;\u0007\u001b[18;1H\u001b[2K\u001b[48;2;24;65;75m       "]
